# ==============================================================================
# Logistics Demand & ETA Forecasting Platform - Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logistics
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logistics

# Redis 7 (Feast Online Store)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# Redpanda (Kafka-compatible Message Broker)
REDPANDA_BROKER=localhost:9092

# MLflow Tracking & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000

# Cloudflare R2 (Model Artifact & Database Backup - ADR-007)
R2_BUCKET_NAME=logistics-forecasting-artifacts
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<cloudflare_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<cloudflare_r2_secret_access_key>

# External Real-Time Feeds (Phase 4 - Streaming Layer)
# MTA GTFS-RT API Key (https://api.mta.info)
MTA_API_KEY=
# NYC Open Data / Socrata App Token for Real-Time Traffic Speed (https://data.cityofnewyork.us/signup)
NYC_TRAFFIC_APP_TOKEN=
# OpenWeatherMap API Key (https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=

# Prefect Cloud (Orchestration - Optional for local dev)
PREFECT_API_KEY=
PREFECT_API_URL=

# LLM Providers (Phase 7 - Ops Copilot Agent)
GROQ_API_KEY=
GEMINI_API_KEY=

# Monitoring & Automated Retraining (Phase 8 - ADR-026)
AUTO_RETRAIN_ON_DRIFT=false
DRIFT_RETRAIN_COOLDOWN_HOURS=48

# Free managed-cloud profile (see docs/Deployment.md). Keep local defaults above
# for Compose. Supply these as hosting environment/GitHub secrets for cloud jobs.
# DEPLOYMENT_MODE=cloud
# DATABASE_URL=postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@HOST:PORT/DB?sslmode=verify-full
# POSTGRES_SSLROOTCERT=/etc/secrets/postgres-ca.pem
# REDIS_URL=rediss://USER:URL_ENCODED_PASSWORD@HOST:PORT/0
# REDIS_SSL_CA=/etc/secrets/valkey-ca.pem
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_SSL_CAFILE=.certs/kafka-ca.pem
# KAFKA_SSL_CERTFILE=.certs/service.cert
# KAFKA_SSL_KEYFILE=.certs/service.key
# For another broker using SASL (optional; TLS remains mandatory):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# MLFLOW_TRACKING_URI=https://dagshub.com/OWNER/REPO.mlflow
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MLFLOW_MODEL_LOAD_MODE=native
# FASTAPI_URL=https://YOUR-VERIFIED-SERVICE.onrender.com
# CORS_ORIGINS=https://YOUR-VERIFIED-APP.streamlit.app
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=SET_A_CURRENT_FREE_MODEL_FROM_AI_STUDIO
# AGENT_API_KEY=GENERATE_A_RANDOM_SHARED_SECRET
# AGENT_REQUESTS_PER_MINUTE=3

