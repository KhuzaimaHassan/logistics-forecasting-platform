# Copy to .env and fill in. Never commit .env — see docs/Security.md

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=logistics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Redpanda
REDPANDA_BROKER=redpanda:9092

# Prefect Cloud
PREFECT_API_KEY=
PREFECT_API_URL=

# External APIs
MTA_API_KEY=
OPENWEATHERMAP_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Cloudflare R2 (Model Artifact & Database Backup - ADR-007)
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

